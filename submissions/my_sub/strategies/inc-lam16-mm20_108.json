{
  "_comment": "High-score submitted version. w_ema(lam=0) over Adam EMA (beta1=0.999, beta2=0.9999) + build_incremental with score-aware thresholds, DS-EPLB bootstrap on call 1, unique-per-device move filter, and top-K-PAR-gain layer selection.",

  "ema": {
    "beta1": 0.999,
    "beta2": 0.9999
  },

  "estimate_w": {
    "fn": "w_ema",
    "params": { "lam": 0.0 }
  },

  "build_deployment": {
    "fn": "build_incremental",
    "params": {
      "max_moves_per_layer": 40,
      "min_par_gain_B":      0.0,
      "min_par_gain_A":      0.0,
      "score_aware":         false,
      "assumed_cycle_iters": 1024,
      "assumed_total_iters": 10000,
      "use_dseplb_init":     true,
      "max_cold_tries":      32,
      "unique_per_device":   true,
      "pin_hottest":         false,
      "fuse_phases":         true,
      "strict_b_prune":      false
    }
  },

  "select_layers": {
    "fn": "select_top_k_par_gain",
    "params": { "k": null, "threshold": 0.0 }
  }
}
