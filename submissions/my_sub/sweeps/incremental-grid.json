{
  "_comment": "Focused 3-axis sweep around inc-lam16-mm20: select_top_k_par_gain.k (around 3), build_incremental.cov_quantile (window cov), and build_incremental.score_aware. Everything else is pinned to the inc-lam16-mm20 baseline.",

  "estimate_w_fn":       "w_ema",
  "build_deployment_fn": "build_incremental",
  "select_layers_fn":    "select_top_k_par_gain",

  "ema": {
    "beta1":           0.999,
    "beta2":           0.9999,
    "track_corr":      false,
    "beta_corr":       0.999,
    "bias_correction": true
  },

  "estimator_params": {
    "lam":        [0.0],
    "std_source": ["ema"]
  },

  "builder_params": {
    "max_moves_per_layer": [20],
    "min_par_gain_B":      [0.0],
    "min_par_gain_A":      [0.0],
    "score_aware":         [true, false],
    "assumed_cycle_iters": [1024],
    "assumed_total_iters": [10000],
    "use_dseplb_init":     [true],
    "max_cold_tries":      [32],
    "unique_per_device":   [true],
    "cov_quantile":        [1.0, 0.99, 0.95, 0.9, 0.8],
    "cov_source":          ["window"],
    "pin_hottest":         [false]
  },

  "selector_params": {
    "k":         [1, 2, 3, 4, 5, "all"],
    "threshold": [0.0]
  },

  "models":              ["DS-R1", "Qwen3"],
  "eps":                 [32, 64, 128, 256],
  "max_iters":           1000000,
  "collection_interval": 1024,

  "include_deepseek":    true,
  "include_strategies":  ["inc-lam16-mm20"],

  "out": "experiments/results/my_sub/incremental_grid.csv",
  "top": 10
}
